/**
 * TEMPLATE for the projector + MCP worker of an ADDITIONAL isolated group
 * (pairs with workers/sync-hub/wrangler.group.jsonc). Copy once per group:
 *
 *   cp wrangler.group.jsonc wrangler.work.local.jsonc   # gitignored
 *   wrangler d1 create cmem-memory-work   # paste the id below
 *   wrangler deploy -c wrangler.work.local.jsonc
 *
 * Deploy this BEFORE the group's hub, which binds to it by name. Never share
 * one projector between groups: these tables have no user_id column, so both
 * corpora would merge and either MCP_TOKEN would read all of it.
 * Secrets: CMEM_INTERNAL_PROJECTOR_SECRET (matching this group's hub),
 * MCP_TOKEN. The schema applies itself on first use.
 */
{
	"name": "cmem-self-host-<GROUP>",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-14",
	"d1_databases": [
		{
			"binding": "MEMDB",
			"database_name": "cmem-memory-<GROUP>",
			// wrangler d1 create cmem-memory-<GROUP> — never shared between groups.
			"database_id": "REPLACE_WITH_THIS_GROUPS_D1_DATABASE_ID"
		}
	],
	"observability": {
		"enabled": true
	}
}
